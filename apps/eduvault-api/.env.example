# Server
PORT=5100
NODE_ENV=development
# EduVault web origin (consent links point here)
CLIENT_ORIGIN=http://localhost:5174

# MongoDB connection string. Can be the same Atlas cluster as EduBridge:
# EduVault always uses its own database (MONGODB_DB), so the data never mixes.
# Leave empty in development to use an in-memory MongoDB (data resets on restart, demo data auto-seeded).
MONGODB_URI=
MONGODB_DB=eduvault

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Encrypts institution private signing keys at rest. 64 hex characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it later makes existing signing keys unusable.
KEY_ENCRYPTION_KEY=

# Private folder for uploaded marksheet PDFs
UPLOAD_DIR=./uploads

# EduBridge registered as a partner. The same ID and secret go in apps/edubridge-api/.env
EDUBRIDGE_CLIENT_ID=edubridge
EDUBRIDGE_CLIENT_SECRET=
EDUBRIDGE_REDIRECT_URIS=http://localhost:5173/dashboard/eduvault/callback

# Email (SMTP) for sending activation codes to students. The same Gmail settings as EduBridge work here.
# Leave SMTP_HOST empty in development to print the emails in the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Brevo API key (optional). When set, email is sent through Brevo over HTTPS instead of SMTP.
# Use it on hosts that block SMTP, such as Render's free plan. MAIL_FROM must be a sender verified in Brevo.
BREVO_API_KEY=
