# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string.
# Leave empty in development to use an in-memory MongoDB (data resets on restart, demo users auto-seeded).
MONGODB_URI=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Private document storage directory (outside any public folder)
UPLOAD_DIR=./uploads

# EduVault (simulated DigiLocker) — EduBridge is registered there as a partner.
# Use the same ID and secret as EDUBRIDGE_CLIENT_ID / EDUBRIDGE_CLIENT_SECRET in apps/eduvault-api/.env
EDUVAULT_API_URL=http://localhost:5100
EDUVAULT_CLIENT_ID=edubridge
EDUVAULT_CLIENT_SECRET=

# Encrypts sensitive fields (Aadhaar numbers) at rest. 64 hex characters. Required in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it safe: if it is lost, stored Aadhaar numbers cannot be read.
DATA_ENCRYPTION_KEY=
