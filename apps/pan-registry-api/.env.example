# PAN Registry (simulation). A practice registry for the EduBridge project.
# It is NOT connected to the Income Tax Department. Add made-up records only.
PORT=5200
NODE_ENV=development

# MongoDB connection string. Can be the same Atlas cluster as EduBridge:
# the registry always uses its own database (MONGODB_DB), so the data never mixes.
# Leave empty in development to use an in-memory MongoDB (records reset on restart).
MONGODB_URI=
MONGODB_DB=panregistry

# Key for the records page at http://localhost:5200 (at least 16 characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_KEY=

# EduBridge, registered as a partner. The same ID and secret go in apps/edubridge-api/.env
# as PAN_REGISTRY_CLIENT_ID / PAN_REGISTRY_CLIENT_SECRET (at least 32 characters).
EDUBRIDGE_CLIENT_ID=edubridge
EDUBRIDGE_CLIENT_SECRET=

# Email for one-time passwords. Leave SMTP_HOST empty in development: codes are then printed
# in this service's console. For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=<your Gmail address>, SMTP_PASS=<a Gmail app password, not your normal password>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
